export function getArticleById(id: string): ScienceArticle | null {
  for (let i = 0; i < SCIENCE_ARTICLES.length; i++) {
    if (SCIENCE_ARTICLES[i].id === id) {
      return SCIENCE_ARTICLES[i];
    }
  }
  return null;
}
